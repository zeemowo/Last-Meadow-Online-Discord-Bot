{
  "manifest_version": 3,
  "name": "Last Meadow Online Bot - Firefox",
  "version": "1.0",
  "description": "Automation bot for Last Meadow Online Discord activity.",
  "permissions": ["storage"],
  "host_permissions": ["https://discord.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "last-meadow-bot@discord.bot",
      "strict_min_version": "109.0"
    }
  }
}
